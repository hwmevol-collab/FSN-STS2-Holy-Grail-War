{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "category": {
      "const": "rooms"
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1
    },
    "gameCommit": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetSourceAudit": {
            "type": "object"
          },
          "contentDependencies": {
            "type": "array"
          },
          "roomTypeId": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "RoomType",
              "MapPointType"
            ]
          },
          "normalRunReachable": {
            "type": "boolean"
          },
          "classification": {
            "enum": [
              "NATIVE_SAFE",
              "GENERIC_ADAPTER",
              "CUSTOM_ADAPTER",
              "FILTERED_PUBLIC_ALPHA"
            ]
          },
          "currentSupport": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "neededAdapter": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "saveRisk": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mapEligibility": {
            "type": "object"
          },
          "publicAlphaStatus": {
            "enum": [
              "ENABLE_AFTER_CUSTOM_ADAPTER",
              "ENABLE_AFTER_E2_GENERIC",
              "KEEP_FILTERED_FOR_V0_0_0_0_1"
            ]
          },
          "customReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "filterReason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "targetSourceAudit",
          "contentDependencies",
          "roomTypeId",
          "domain",
          "normalRunReachable",
          "classification",
          "currentSupport",
          "neededAdapter",
          "saveRisk",
          "mapEligibility",
          "publicAlphaStatus",
          "customReason",
          "filterReason"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "GENERIC_ADAPTER"
                }
              }
            },
            "then": {
              "properties": {
                "neededAdapter": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "CUSTOM_ADAPTER"
                }
              }
            },
            "then": {
              "properties": {
                "customReason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "customReason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "FILTERED_PUBLIC_ALPHA"
                }
              }
            },
            "then": {
              "properties": {
                "filterReason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "filterReason"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "category",
    "gameVersion",
    "gameCommit",
    "items"
  ]
}
